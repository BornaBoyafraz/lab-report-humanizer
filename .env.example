# ---------------------------------------------------------------------------
# Lab Report Humanizer — environment
# Copy this file to `.env.local` and fill in the values you need.
# ---------------------------------------------------------------------------

# AI engine (optional). The rule-based humanizer works with NO key at all.
# To enable the AI engine, create an AI Gateway key at https://vercel.com/ai-gateway
# (or run `vercel link` and `vercel env pull`), then set:
AI_GATEWAY_API_KEY=

# Which model the AI engine uses, as a Vercel AI Gateway "creator/model" string.
# Examples: anthropic/claude-sonnet-4.5 · openai/gpt-4o · google/gemini-2.5-pro
# Defaults to anthropic/claude-sonnet-4.5 if unset.
HUMANIZER_MODEL=anthropic/claude-sonnet-4.5
